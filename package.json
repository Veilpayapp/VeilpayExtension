{
  "name": "veilpay-extension",
  "version": "0.0.1",
  "private": true,
  "description": "Veilpay browser extension — self-custody multi-chain wallet with native agent payments (VAP) and x402 support",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:check-size": "node scripts/check-bundle-size.mjs",
    "gate:bundle": "node scripts/check-bundle-size.mjs",
    "gate:secrets": "node scripts/check-secret-leaks.mjs",
    "gate:all": "npm run typecheck && npm run lint && npm run test && npm run build:only && npm run gate:bundle && npm run gate:secrets",
    "x402:server": "node scripts/x402-reference-server.mjs",
    "smoke:agent": "node scripts/smoke-agent-stack.mjs",
    "package": "node scripts/package-extension.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "@walletconnect/sign-client": "2.17.0",
    "@walletconnect/utils": "2.17.0",
    "idb": "8.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.2.0",
    "@eslint/js": "9.39.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/chrome": "0.1.29",
    "@types/node": "20.19.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "10.4.21",
    "axe-core": "^4.13.0",
    "eslint": "9.39.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.0.1",
    "fast-check": "4.3.0",
    "globals": "15.15.0",
    "jest-axe": "^11.0.0",
    "jsdom": "26.1.0",
    "jsqr": "^1.4.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "sharp": "0.35.3",
    "snarkjs": "0.7.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
